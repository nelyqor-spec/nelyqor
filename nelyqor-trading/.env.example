# Copier en .env (jamais commité). Noms de variables uniquement : AUCUN secret ici.
# Les clés Bitvavo et le hash du mot de passe vont dans ./secrets/ (fichiers, chmod 600).

# Nom de domaine pointant vers l'IPv4 fixe du VPS (HTTPS automatique par Caddy)
NELYQOR_DOMAIN=

# Laisser à false tant que le propriétaire n'a pas décidé d'autoriser le réel.
# Même à true, l'activation exige en plus une action authentifiée depuis l'iPhone.
NELYQOR_REAL_TRADING_ALLOWED=false

# operatorId Bitvavo (entier choisi par le propriétaire, cf. documentation create-order)
BITVAVO_OPERATOR_ID=1

# Coût mensuel TTC réel de l'hébergement, pour le résultat économique
NELYQOR_HOSTING_EUR=7.19

# Alertes Telegram optionnelles (identifiant de conversation, non secret) ; le jeton du bot va dans secrets/
TELEGRAM_CHAT_ID=
