  "description": "Suis tes revenus et progresse vers ton objectif financier.",
  "lang": "fr",
  "start_url": "./index.html",
  "id": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "orientation": "any",
  "background_color": "#0F1720",
