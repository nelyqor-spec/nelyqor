# Copier en variables d'environnement de l'hébergeur. Ne jamais committer les valeurs réelles.
GOOGLE_MAPS_API_KEY=REPLACE_ME
# Jeton partagé avec l'app iPhone (Réglages > Serveur). Générer : openssl rand -hex 32
API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
PORT=8080
# Garde-fous de coût
RATE_PER_MINUTE=20
DAILY_CAP=300
# Démo seulement, durées FICTIVES et explicitement marquées [DÉMO] :
MOCK_MAPS=1
